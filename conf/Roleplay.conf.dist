[worldserver]

###################################################################################################
# ROLEPLAY MODULE
###################################################################################################

# Enable the roleplay module.
# Default: 1
Roleplay.Enable = 1

# Character name eligible for the Lyon-specific Shadow Wand story.
# Default: "Lyon"
Roleplay.Lyon.CharacterName = "Lyon"

# Item entry of the carried Shadow Wand relic.
# Default: 32618
Roleplay.Lyon.ShadowWandItemId = 32618

###################################################################################################
# LYON: SHADOW WAND MECHANICS
###################################################################################################

# Reduce incoming damage while the Shadow Wand is carried.
Roleplay.Lyon.DarkAegis.Enable = 1
Roleplay.Lyon.DarkAegis.DamageReductionPct = 3.0

# Retaliate after taking nonzero damage. Spell 900001 is a zero-cost module-owned Shadow spell.
Roleplay.Lyon.DeathsReprisal.Enable = 1
Roleplay.Lyon.DeathsReprisal.ChancePct = 5.0
Roleplay.Lyon.DeathsReprisal.CooldownMs = 1000
Roleplay.Lyon.DeathsReprisal.SpellId = 900001

# Client-known, visual-only NPC Shadow Bolt used after spell 900001 succeeds.
# Set to 0 to disable the projectile. Spell 33335 has no power cost or damage effect.
Roleplay.Lyon.DeathsReprisal.VisualSpellId = 33335

Roleplay.Lyon.DeathsReprisal.BaseDamage = 25
Roleplay.Lyon.DeathsReprisal.DamagePerLevel = 2

# Temporarily log Lyon's authoritative mana immediately before and after each reprisal cast.
Roleplay.Lyon.DeathsReprisal.DebugMana = 1

# Prevent a lethal hit when this effect is available. Spell 48792 is Icebound Fortitude.
Roleplay.Lyon.RefusalOfDeath.Enable = 1
Roleplay.Lyon.RefusalOfDeath.ChancePct = 100.0
Roleplay.Lyon.RefusalOfDeath.CooldownMs = 600000
Roleplay.Lyon.RefusalOfDeath.SpellId = 48792

# Send subtle system messages only to Lyon.
Roleplay.Lyon.Messages.Personal = 1
