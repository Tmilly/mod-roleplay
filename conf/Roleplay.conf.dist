[worldserver]

###################################################################################################
# ROLEPLAY MODULE
###################################################################################################

# Enable the roleplay module.
# Default: 1
Roleplay.Enable = 1

# Character name eligible for the Lyon-specific Shadow Wand story.
# Default: "Lyon"
Roleplay.Lyon.CharacterName = "Lyon"

# Item entry of the carried Shadow Wand relic.
# Default: 32618
Roleplay.Lyon.ShadowWandItemId = 32618

###################################################################################################
# LYON: SHADOW WAND MECHANICS
###################################################################################################

# Reduce incoming damage while the Shadow Wand is carried.
Roleplay.Lyon.DarkAegis.Enable = 1
Roleplay.Lyon.DarkAegis.DamageReductionPct = 3.0

# Retaliate after taking nonzero damage. Spell 900001 is a zero-cost module-owned Shadow spell.
Roleplay.Lyon.DeathsReprisal.Enable = 1
Roleplay.Lyon.DeathsReprisal.ChancePct = 5.0
Roleplay.Lyon.DeathsReprisal.CooldownMs = 1000
Roleplay.Lyon.DeathsReprisal.SpellId = 900001

# Client-known, visual-only NPC Shadow Bolt used after spell 900001 succeeds.
# Set to 0 to disable the projectile. Spell 33335 has no power cost or damage effect.
Roleplay.Lyon.DeathsReprisal.VisualSpellId = 33335

Roleplay.Lyon.DeathsReprisal.BaseDamage = 25
Roleplay.Lyon.DeathsReprisal.DamagePerLevel = 2

# Temporarily log Lyon's authoritative mana immediately before and after each reprisal cast.
Roleplay.Lyon.DeathsReprisal.DebugMana = 1

# Prevent a lethal hit when this effect is available. Spell 48792 is Icebound Fortitude.
Roleplay.Lyon.RefusalOfDeath.Enable = 1
Roleplay.Lyon.RefusalOfDeath.ChancePct = 100.0
Roleplay.Lyon.RefusalOfDeath.CooldownMs = 600000
Roleplay.Lyon.RefusalOfDeath.SpellId = 48792

# Send subtle system messages only to Lyon.
Roleplay.Lyon.Messages.Personal = 1

###################################################################################################
# IRONBELLY COOKING
###################################################################################################

# Character allowed to learn the Phase 1 Ironbelly recipe set.
Roleplay.Ironbelly.CharacterName = "Dorrin"

###################################################################################################
# DEATH KNIGHT PROGRESSION (all options require a worldserver restart)
###################################################################################################
# New DKs level in Azeroth, then play the original Acherus campaign. No quest credit is fabricated.
# This subsystem also requires Roleplay.Enable. Disable other DK-start/skip modules.
# The module sets StartHeroicPlayerLevel and the account's DK minimum-level requirement at runtime.
# Expansion must remain 2, and HeroicCharactersPerRealm must permit DK creation.
# Character settings storage is enabled automatically for transactional recovery.
#
# For mod-individual-progression, set these in individualProgression.conf BEFORE creating a DK:
# IndividualProgression.DeathKnightUnlockProgression = 0
# IndividualProgression.DeathKnightStartingProgression = 0
# Roleplay never changes IP progression or overrides its account/race/content restrictions.
Roleplay.DeathKnight.Enable = 1

# Range 1-55. Normal accounts are recommended for creation testing (GM start levels differ in core).
Roleplay.DeathKnight.StartLevel = 1

# Uses the realm's existing warrior racial start; Blood Elves use paladin racial data.
# Forced on when StartLevel <55, because original Acherus quests require level 55.
Roleplay.DeathKnight.UseRacialStartingZone = 1

# Range 1-80. Applies only to enrolled custom DKs. Ordinary classes and stock DKs are unaffected.
Roleplay.DeathKnight.PlateLevel = 40

# Managed DK ability damage only, including the complete special weapon strike and diseases.
# Default curve: 1=6%, 5=8%, 10=12%, 20=28%, 30=43%, 40=60%, 50=80%, 55=100%.
# White attacks, pets, other spell families and percentage healing remain stock.
Roleplay.DeathKnight.EnableLowLevelScaling = 1
# Range 2-55: compresses the curve to reach normal damage earlier. Legacy 60 is clamped to 55.
# Levels 55+ ALWAYS have normal damage, independently of this setting.
Roleplay.DeathKnight.FullDamageScalingLevel = 55
# Raise the curve to this power: >1 reduces early damage, <1 increases it; 1 uses the anchors above.
# Range 0.5-2.0. Keeps the normal-damage endpoint intact. Restart required for configuration changes.
# Obsolete MinimumDamageMultiplier is ignored; remove it from existing Roleplay.conf files.
Roleplay.DeathKnight.DamageCurveExponent = 1.0

# Disabling the transition leaves the campaign pending; it does not skip or reward it.
Roleplay.DeathKnight.DelayedAcherusCampaign = 1

# Range 55-80; values below 55 are clamped to the stock quests' minimum level.
Roleplay.DeathKnight.AcherusCampaignLevel = 55

# Deliver the preserved race/gender DBC outfit plus positive playercreateinfo_item additions.
# Always inventory first, mail overflow. Automatic equipment replacement is deliberately unsupported.
# No AutoEquipAcherusStartingGear option: campaign starter equipment is NEVER auto-equipped.
Roleplay.DeathKnight.GiveAcherusStartingGear = 1

# Adopt an existing 55+ DK only with no campaign history and outside map 609.
# Existing unmarked DKs inside Acherus are ambiguous stock characters and are left alone.
Roleplay.DeathKnight.RecoverExistingCharacters = 1

# Optional rewarded quest required before entry (0 = none). Use an existing IP milestone quest
# if your realm gates Acherus; this only defers entry, never grants progression or access.
Roleplay.DeathKnight.AcherusRequiredQuest = 0

###################################################################################################
# ALDRIC: BLOOD KNIGHT (character-specific DK/affliction prototype)
###################################################################################################
# Only the configured Death Knight receives this subsystem. A nonzero GUID takes precedence over
# the name, allowing the character to be renamed or change race without losing the identity.
Roleplay.BloodKnight.Enable = 1
Roleplay.BloodKnight.CharacterName = "Aldric"
Roleplay.BloodKnight.CharacterGuid = 0

# Auxiliary server-side Mana. Runic Power remains the DK active power type; the core hook admits
# Mana-cost spells for Aldric and their stock DBC cost is charged against POWER_MANA.
Roleplay.BloodKnight.Mana.Enable = 1
Roleplay.BloodKnight.Mana.BasePerLevel = 20
Roleplay.BloodKnight.Mana.IntellectMultiplier = 15.0
Roleplay.BloodKnight.Mana.OutOfCombatRegenPct = 2.0

# Selected stock WotLK Warlock spells and their rank progression.
Roleplay.BloodKnight.Spells.EnableDrainLife = 1
Roleplay.BloodKnight.Spells.EnableCurseOfWeakness = 1
Roleplay.BloodKnight.Spells.EnableCurseOfAgony = 1
Roleplay.BloodKnight.Spells.EnableFear = 1
Roleplay.BloodKnight.Spells.EnableShadowfury = 1

# Conservative Blood/affliction interactions.
Roleplay.BloodKnight.Synergy.BloodPlagueDrain = 1
Roleplay.BloodKnight.Synergy.VampiricBlood = 1
Roleplay.BloodKnight.Synergy.SoulFeast = 1
Roleplay.BloodKnight.Synergy.BloodPlagueDrainPct = 7.0
